# Django
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret
# "web" (the docker-compose service name) must stay in this list even in
# production: Orthanc's Authorization plugin calls back into Django as
# http://web:8000/imaging/orthanc-auth/... using that Host header.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Production only (docker-compose.prod.yml + Caddy). Leave DEBUG=True and
# DJANGO_USE_HTTPS=False for local development.
# DOMAIN=vault.example.com
# DJANGO_USE_HTTPS=True
# DJANGO_ALLOWED_HOSTS=vault.example.com
# CSRF_TRUSTED_ORIGINS=https://vault.example.com,https://orthanc.vault.example.com

# PostgreSQL
POSTGRES_DB=rabivault
POSTGRES_USER=rabivault_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO root user used by the MinIO container
MINIO_ROOT_USER=rabivault_minio
MINIO_ROOT_PASSWORD=change-me

# Enables MinIO's built-in server-side encryption at rest for the document
# bucket. Generate with: python -c "import secrets,base64; print('rabivault-key:' + base64.b64encode(secrets.token_bytes(32)).decode())"
MINIO_KMS_SECRET_KEY=rabivault-key:change-this-to-a-generated-32-byte-base64-key

# Main document bucket. Keep this identical to AWS_STORAGE_BUCKET_NAME.
MINIO_BUCKET_NAME=rabivault-files

# Django S3/MinIO storage settings
AWS_ACCESS_KEY_ID=rabivault_minio
AWS_SECRET_ACCESS_KEY=change-me
AWS_STORAGE_BUCKET_NAME=rabivault-files
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Orthanc
ORTHANC_AET=RABIVAULT

# Public URL the app's "Studies" sidebar link redirects approved users to.
# Local dev: http://localhost:8042. Production: https://orthanc.vault.example.com
ORTHANC_URL=http://localhost:8042

# URL this Django app itself uses to reach Orthanc's REST API (label
# management). The docker-compose service name, not the public ORTHANC_URL.
ORTHANC_INTERNAL_URL=http://orthanc:8042

# Long random secret Django sends as the Orthanc "token" header on its own
# REST calls (e.g. pushing organization/facility labels onto a study); the
# webhook in apps/imaging/views.py recognizes this exact value as an
# all-access service identity. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ORTHANC_SERVICE_TOKEN=change-this-to-a-generated-secret

# HTTP Basic Auth credentials Orthanc's Authorization plugin sends on every
# call it makes back into apps/imaging/views.py's webhooks, so those webhooks
# can reject anyone who isn't our own Orthanc instance. Generate the password
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ORTHANC_WEBHOOK_USERNAME=orthanc-authz
ORTHANC_WEBHOOK_PASSWORD=change-this-to-a-generated-secret

# Passphrase used to GPG-encrypt database backups (docker-compose.prod.yml's
# backup container). Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=change-this-to-a-generated-passphrase
